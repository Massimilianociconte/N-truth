# N-Truth non carica automaticamente file .env.
# Copiare solo le variabili necessarie ed esportarle nella shell.
# Non inserire token, password o percorsi contenenti dati riservati.

# --- Ruleset opzionale ---
# NTRUTH_RULESETS=/percorso/assoluto/rulesets

# --- Train A: modello primario provvisorio (MiniCPM5-2B, ADR-0019) ---
NTRUTH_MODEL_PROVIDER=minicpm
NTRUTH_MODEL_ID=openbmb/MiniCPM5-2B
NTRUTH_MODEL_PROFILE=BALANCED
NTRUTH_MODEL_QUANTIZATION=auto
NTRUTH_STRUCTURED_OUTPUT=true
# NTRUTH_ML_PROFILE=models/configs/minicpm5-2b-mlx-qlora.json

# Legacy Granite: MAI default. Solo opt-in esplicito per confronti storici:
# NTRUTH_MODEL_PROVIDER=granite
# NTRUTH_ALLOW_LEGACY_GRANITE=1

# Legacy Qwen: MAI default. Solo opt-in esplicito per ablation storiche:
# NTRUTH_MODEL_PROVIDER=legacy_qwen
# NTRUTH_ALLOW_LEGACY_QWEN=1
