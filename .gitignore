__pycache__/
*.py[cod]
.venv/
venv/
.uv/
.worktrees/
dist/
build/
*.egg-info/

# La directory deve esistere in un clone pulito perché Hatch la include nel wheel;
# gli asset Vite restano ricostruibili e non versionati.
!apps/desktop/dist/
apps/desktop/dist/*
!apps/desktop/dist/.gitkeep
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.idea/
.vscode/
.qoder/
.env
.env.*
!.env.example
*.log
coverage.xml
junit.xml
node_modules/
tmp/
playwright-report/
test-results/
*.tsbuildinfo

# Il PRD sorgente e materiale istruttorio locale. Nel repository pubblico resta
# soltanto il record di provenienza/checksum in prd/README.md.
prd/*.pdf
prd/*.docx
prd/*.odt
prd/*.source.md

# Workspace utente: contiene dati potenzialmente non pubblici (PRD 21.1)
workspace/
local-data/
data/raw/
data/external/
data/processed/
data/annotations/*/
!data/annotations/.gitkeep
# Private collaboration / contact registries (never commit PII or correspondence)
N-Truth-Private/
**/collaboration-registry.private.yaml
**/collaboration-registry.private.yml
models/checkpoints/
models/runs/
models/local/
models/cache/
models/adapters/
models/exports/
models/registry/qualification_ledger.sqlite3
models/registry/qualification_ledger.sqlite3-*
models/registry/qualification_evidence/
*.ckpt
*.safetensors

# Credenziali e materiale di firma non devono mai entrare nel repository.
*.pem
*.key
*.p12
*.pfx

# Private collaboration / contact registries (never commit PII or correspondence)
N-Truth-Private/
**/collaboration-registry.private.yaml
**/collaboration-registry.private.yml
